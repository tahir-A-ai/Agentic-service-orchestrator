# ─────────────────────────────────────────────
# Service Orchestrator — Single Root Git Ignore
# ─────────────────────────────────────────────

# Database files & SQLite runtime locks
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment & secrets
.env
.env.local
.env.*.local
*.env

# Python / Backend
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
trace_logs.txt

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, Editors & OS System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.DS_Store
Thumbs.db
