# ─────────────────────────────────────────────────────────────
# Service Orchestrator — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and NEVER committed.

# Groq API Key (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (legacy — kept for reference, no longer actively used)
GEMINI_API_KEY=your_gemini_api_key_here

# Application environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT Secret for authentication session cookies (generate a secure random 64-char string)
JWT_SECRET=your_jwt_secret_here

# Database URL — defaults to local SQLite (backend/providers.db) if unset.
# For production PostgreSQL, set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# CORS — comma-separated list of allowed origins (no trailing slashes).
# IMPORTANT: Wildcard (*) is NOT allowed when allow_credentials=True (HttpOnly cookies).
# Local development example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (raw EC2 IP, before domain is configured):
# CORS_ALLOW_ORIGINS=http://43.204.219.254:8000,http://localhost:5173
# Production (after domain + HTTPS):
# CORS_ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── AWS S3 + CloudFront ──────────────────────────────────────────────────────
# Provider photo uploads. When S3_BUCKET_NAME and CLOUDFRONT_URL are set,
# the upload endpoint streams files to S3 and returns a CloudFront URL.
# When left blank (local dev), uploads are saved to the local uploads/ folder.
#
# On EC2, do NOT set these in a .env file — inject them as environment variables
# in the systemd service unit [Service] section or via AWS Parameter Store.
#
# Notes:
#   - CLOUDFRONT_URL: no trailing slash
#   - S3_BUCKET_NAME: the private bucket; OAC handles CloudFront → S3 access
#   - AWS_REGION: the region your bucket is in (default: ap-south-1)
#   - boto3 authenticates via the EC2 IAM Instance Role — no access keys needed
CLOUDFRONT_URL=https://your-cloudfront-distribution.cloudfront.net
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-south-1
