# ─────────────────────────────────────────────────────────────
# Service Orchestrator — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and NEVER committed.

# Groq API Key (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (legacy — kept for reference, no longer actively used)
GEMINI_API_KEY=your_gemini_api_key_here

# Application environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT Secret for authentication session cookies (generate a secure random 64-char string)
JWT_SECRET=your_jwt_secret_here

# Database URL — defaults to local SQLite (backend/providers.db) if unset.
# For production PostgreSQL, set:
# DATABASE_URL=postgresql://postgres:password@db.projectref.supabase.co:5432/postgres
DATABASE_URL=
